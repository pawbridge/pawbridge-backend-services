    {
      "id": 12,
      "type": "table",
      "title": "엔드포인트별 요청 수 (선택 기간)",
      "description": "고른 기간의 합계. increase 기반 근사값. 헤더를 누르면 정렬, 깔때기로 거르기. p95 는 히스토그램 칸(0.05, 0.1, 0.25, 0.5, 1, 2, 5초)으로 추정해서 50ms 보다 빠르면 47.5ms 근처로 보인다. notes/stream, chats/socket 은 오래 열어 두는 연결이라 지연이 길게 나온다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\"}[$__range]))) > 0",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\",status=~\"4..\"}[$__range])) or (0 * sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\"}[$__range]))))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\",status=~\"5..\"}[$__range])) or (0 * sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\"}[$__range]))))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\"}[$__range])))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\"}[$__range])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri=~\"$uri\",method=~\"$method\",uri!~\"/actuator.*\"}[$__range]))",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
