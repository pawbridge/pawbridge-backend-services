        "query": {
          "query": "label_values(http_server_requests_seconds_count{job=\"pawbridge-monolith\",uri!~\"/actuator.*\"}, uri)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
