# 시험 환경 compose 변수. 실제 파일은 Git 밖에 두고 `docker compose --env-file`로 준다.
# 이미지는 운영 compose와 같은 것을 쓴다(docker image inspect로 확인한 ID 또는 태그).
POSTGRES_IMAGE=sha256:<운영 postgres 이미지 ID>
REDIS_IMAGE=sha256:<운영 redis 이미지 ID>
MONOLITH_IMAGE=pawbridge-monolith:prod-<sha12>
# make-secrets.sh로 만든 비밀 폴더(Git 밖)
STAGE_SECRETS=/절대/경로/stage/secrets
