@@ -0,0 +1,51 @@
+# PawBridge Mac image-inference adapter. Models and preprocessing stay unchanged.
+import os
+
+import torch
+import torch.nn.functional as F
+
+# 2026-11-04: PyTorch 2.10의 MPS scaled_dot_product_attention은 이 모델의 호출 모양(head 32·64, 질의 512~5,184,
+# bf16, 마스크 없음)에서 실효 0.4~0.8 TFLOPS로 돌아 SAM 3 한 장(2.4초)의 절반 이상을 차지했다. 같은 계산을
+# 행렬곱 → softmax → 행렬곱으로 직접 쓰면 행렬곱 커널(Neural Accelerator)을 타 3~4배 빠르고, 마스크와 동물
+# 벡터는 원래 경로와 같다(고양이·개 200장: 상태 일치 200/200, IoU 최소 0.9991, 코사인 최소 0.9989).
+# PyTorch 2.16이 같은 경로를 Metal 커널로 바꾸므로, 2.16 채택 때 같은 측정으로 재비교한 뒤 이 구현을 제거한다.
+# PAWBRIDGE_SAM3_MPS_ATTENTION=sdpa 로 재빌드 없이 원래 경로(512 질의 분할 + PyTorch 함수)로 되돌린다.
+QUERY_CHUNK = 512
+
+
+def _manual_attention(q, k, v):
+    """마스크·dropout 없는 어텐션을 행렬곱 두 번과 softmax로 계산한다. 입력 dtype(운영은 bf16)을 그대로 쓴다.
+
+    autocast는 softmax를 fp32로 올리며 큰 점수 행렬을 두 번 형 변환하므로 이 함수 안에서는 끈다.
+    질의 축만 512씩 나누고 softmax 축(키)은 나누지 않아 각 행이 완전하다. 스케일은 작은 q에 곱한다.
+    """
+    with torch.autocast(device_type=q.device.type, enabled=False):
+        q = q * (q.shape[-1] ** -0.5)
+        kt = k.transpose(-2, -1)
+
+        def block(part):
+            return torch.matmul(torch.softmax(torch.matmul(part, kt), dim=-1), v)
+
+        if q.shape[-2] <= 1024 or k.shape[-2] <= 1024:
+            return block(q)
+        return torch.cat([block(part) for part in q.split(QUERY_CHUNK, dim=-2)], dim=-2)
+
+
+def _chunked_sdpa(q, k, v):
+    """원래 어댑터 경로: 긴 질의만 512씩 나눠 PyTorch 함수를 부른다(메모리 상한용)."""
+    if q.shape[-2] <= 1024 or k.shape[-2] <= 1024:
+        return F.scaled_dot_product_attention(q, k, v)
+    return torch.cat([F.scaled_dot_product_attention(part, k, v) for part in q.split(QUERY_CHUNK, dim=-2)], dim=-2)
+
+
+def scaled_dot_product_attention(q, k, v, attn_mask=None, dropout_p=0.0, is_causal=False):
+    """MPS 추론의 마스크 없는 어텐션만 직접 구현으로 보낸다.
+
+    CUDA, 학습, 마스크, causal, dropout은 PyTorch 원래 경로를 유지한다. 이 어댑터는 고정된 SAM 3 이미지 모델 전용이다.
+    """
+    if (q.device.type != "mps" or torch.is_grad_enabled() or attn_mask is not None
+            or dropout_p != 0.0 or is_causal):
+        return F.scaled_dot_product_attention(q, k, v, attn_mask, dropout_p, is_causal)
+    if os.environ.get("PAWBRIDGE_SAM3_MPS_ATTENTION") == "sdpa":
+        return _chunked_sdpa(q, k, v)
+    return _manual_attention(q, k, v)
